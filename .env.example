# Interactive Brokers needs no API keys here: Darwin Options connects to a running, logged-in
# IB Gateway (see deploy/ib-gateway) or TWS.

# Live trading is refused unless this is set exactly as below AND mode is live in config.yaml.
# DARWIN_ALLOW_LIVE=yes-i-understand-real-money

# Dashboard address. Default: this machine only. 0.0.0.0 opens it to your home network
# (e.g. your phone at http://<this-machine's-IP>:8000). Paper/sim mode only: there's no login.
# DARWIN_WEB_HOST=0.0.0.0
