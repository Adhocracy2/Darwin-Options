[Unit]
Description=Flick dashboard (API + React UI)
After=network-online.target

[Service]
User=@USER@
WorkingDirectory=@FLICK_HOME@/current
EnvironmentFile=@FLICK_HOME@/shared/.env
# Localhost only on purpose: the dashboard can place trades and has no login.
ExecStart=@FLICK_HOME@/current/.venv/bin/flick serve --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
